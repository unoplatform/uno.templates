<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <customErrors mode="Off"/>
  </system.web>

  <system.webServer>
    <!-- Disable compression as we're doing it through pre-compressed files -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" dynamicCompressionBeforeCache="false" />

    <staticContent>
      <!-- Types are removed before being added so that this file loads whether or not the server already defines them. -->
      <!-- Pre-compressed .gz and .br files are served under their original type. When adding a type, add its .gz and .br
           entries too, otherwise browsers that accept compression get a 404 for files the publish pre-compressed. -->

      <!-- Application files -->
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html" />
      <mimeMap fileExtension=".html.gz" mimeType="text/html" />
      <mimeMap fileExtension=".html.br" mimeType="text/html" />

      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <mimeMap fileExtension=".css.gz" mimeType="text/css" />
      <mimeMap fileExtension=".css.br" mimeType="text/css" />

      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <mimeMap fileExtension=".js.gz" mimeType="application/javascript" />
      <mimeMap fileExtension=".js.br" mimeType="application/javascript" />

      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <mimeMap fileExtension=".mjs.gz" mimeType="application/javascript" />
      <mimeMap fileExtension=".mjs.br" mimeType="application/javascript" />

      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".json.gz" mimeType="application/json" />
      <mimeMap fileExtension=".json.br" mimeType="application/json" />

      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <mimeMap fileExtension=".webmanifest.gz" mimeType="application/manifest+json" />
      <mimeMap fileExtension=".webmanifest.br" mimeType="application/manifest+json" />

      <remove fileExtension=".manifest" />
      <mimeMap fileExtension=".manifest" mimeType="application/json" />

      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="text/xml" />
      <mimeMap fileExtension=".xml.gz" mimeType="text/xml" />
      <mimeMap fileExtension=".xml.br" mimeType="text/xml" />

      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
      <mimeMap fileExtension=".txt.gz" mimeType="text/plain" />
      <mimeMap fileExtension=".txt.br" mimeType="text/plain" />

      <!-- .NET runtime files -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".wasm.gz" mimeType="application/wasm" />
      <mimeMap fileExtension=".wasm.br" mimeType="application/wasm" />

      <remove fileExtension=".dat" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat.gz" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat.br" mimeType="application/octet-stream" />

      <remove fileExtension=".pdb" />
      <mimeMap fileExtension=".pdb" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".pdb.gz" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".pdb.br" mimeType="application/octet-stream" />

      <!-- Fonts -->
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <mimeMap fileExtension=".ttf.gz" mimeType="font/ttf" />
      <mimeMap fileExtension=".ttf.br" mimeType="font/ttf" />

      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <mimeMap fileExtension=".otf.gz" mimeType="font/otf" />
      <mimeMap fileExtension=".otf.br" mimeType="font/otf" />

      <remove fileExtension=".ttc" />
      <mimeMap fileExtension=".ttc" mimeType="font/collection" />
      <mimeMap fileExtension=".ttc.gz" mimeType="font/collection" />
      <mimeMap fileExtension=".ttc.br" mimeType="font/collection" />

      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />

      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <!-- Images -->
      <remove fileExtension=".png" />
      <mimeMap fileExtension=".png" mimeType="image/png" />

      <remove fileExtension=".jpg" />
      <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />

      <remove fileExtension=".jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />

      <remove fileExtension=".gif" />
      <mimeMap fileExtension=".gif" mimeType="image/gif" />

      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />

      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".svg.gz" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".svg.br" mimeType="image/svg+xml" />

      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <mimeMap fileExtension=".ico.gz" mimeType="image/x-icon" />
      <mimeMap fileExtension=".ico.br" mimeType="image/x-icon" />

      <remove fileExtension=".bmp" />
      <mimeMap fileExtension=".bmp" mimeType="image/bmp" />
      <mimeMap fileExtension=".bmp.gz" mimeType="image/bmp" />
      <mimeMap fileExtension=".bmp.br" mimeType="image/bmp" />

      <!-- Media -->
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />

      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />

      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Fingerprinted application files can be cached forever -->
        <rule name="Cache control for fingerprinted files">
          <match url="^(_framework/|package_)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <serverVariables>
            <set name="RESPONSE_Cache-Control" value="public, max-age=31536000, immutable" />
          </serverVariables>
          <action type="None" />
        </rule>

        <!-- Missing application files must fail instead of being served the app root, and their failure must not be cached -->
        <rule name="Missing application files" stopProcessing="true">
          <match url="^(_framework/|package_)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <serverVariables>
            <set name="RESPONSE_Cache-Control" value="no-store" />
          </serverVariables>
          <action type="None" />
        </rule>

        <rule name="Lookup for pre-compressed brotli file" stopProcessing="true">
          <match url="(.*)$"/>
          <conditions>
            <!-- Match brotli requests -->
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />

            <!-- Don't rewrite requests that already end with .br -->
            <add input="{REQUEST_URI}" pattern="\.br$" negate="true" />

            <!-- Check if the pre-compressed .br file exists on the disk -->
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <serverVariables>
            <set name="RESPONSE_X_COMPRESSION_APPLIED" value="br" />
          </serverVariables>
          <action type="Rewrite" url="{R:0}.br" />
        </rule>

        <rule name="Lookup for pre-compressed gzip file" stopProcessing="true">
          <match url="(.*)$"/>
          <conditions>
            <!-- Match gzip requests -->
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="gzip" />

            <!-- Don't rewrite requests that already end with .gz -->
            <add input="{REQUEST_URI}" pattern="\.gz$" negate="true" />

            <!-- Check if the pre-compressed .gz file exists on the disk -->
            <add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
          </conditions>
          <serverVariables>
            <set name="RESPONSE_X_COMPRESSION_APPLIED" value="gzip" />
          </serverVariables>
          <action type="Rewrite" url="{R:0}.gz" />
        </rule>

        <rule name="SPA fallback - serve app root for client routes" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <!-- Serve existing files and directories as-is -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>

      <outboundRules>
        <rule name="Adjust content encoding for gzip pre-compressed files">
          <match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_X_COMPRESSION_APPLIED}" pattern="^gzip$" />
          </conditions>
          <action type="Rewrite" value="gzip"/>
        </rule>

        <rule name="Adjust content encoding for brotli pre-compressed files">
          <match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_X_COMPRESSION_APPLIED}" pattern="^br$" />
          </conditions>
          <action type="Rewrite" value="br"/>
        </rule>


        <!-- Cache control: everything not handled above must always revalidate -->
        <rule name="Cache control for other files" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache-Control" pattern="^$" />
          <action type="Rewrite" value="no-cache"/>
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
