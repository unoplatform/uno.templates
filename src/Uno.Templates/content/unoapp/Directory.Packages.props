<Project ToolsVersion="15.0">
  <!--
    To update the version of Uno, you should instead update the Sdk version in the global.json file.

    See https://aka.platform.uno/using-uno-sdk for more information.
    See https://aka.platform.uno/using-uno-sdk#implicit-packages for more information regarding the Implicit Packages.
  -->
  <ItemGroup>
    <!--#if (useTestSolutionFolder)-->
    <PackageVersion Include="coverlet.collector" Version="$CoverletCollector$" />
    <PackageVersion Include="FluentAssertions" Version="$FluentAssertions$" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$MicrosoftTestSdk$" />
    <PackageVersion Include="NUnit" Version="$NUnit$" />
    <PackageVersion Include="NUnit3TestAdapter" Version="$NUnit3TestAdapter$" />
    <!--#if (useGitHubActions)-->
    <PackageVersion Include="GitHubActionsTestLogger" Version="2.3.3" />
    <!--#endif-->
    <!--#endif-->
    <!--#if (useUITests)-->
    <PackageVersion Include="Newtonsoft.Json" Version="$NewtonsoftJson$" />
    <!--#endif-->
    <!--#if (useAspNetCoreSerilogPackage)-->
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.1" />
    <!--#endif-->
    <!--#if (useAspire)-->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$AspireVersion$" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="$AspireVersion$" />
    <!-- Keep in step with the Uno.Extensions version of the Uno.Sdk in global.json. -->
    <PackageVersion Include="Uno.Extensions.Aspire.Hosting" Version="$UnoExtensionsVersion$" />
    <!--#endif-->
    <!--#if (useAspireServer)-->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$AspireServiceDefaultsExtensionsVersion$" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$AspireServiceDefaultsExtensionsVersion$" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$AspireServiceDefaultsOpenTelemetryVersion$" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$AspireServiceDefaultsOpenTelemetryVersion$" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$AspireServiceDefaultsOpenTelemetryVersion$" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$AspireServiceDefaultsOpenTelemetryVersion$" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$AspireServiceDefaultsOpenTelemetryVersion$" />
    <!--#endif-->
    <!--#if (useServer)-->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!--#endif-->
    <!--#if (useUITests)-->
    <PackageVersion Include="Uno.UITest.Helpers" Version="$UnoUITestHelpersVersion$" />
    <PackageVersion Include="Xamarin.UITest" Version="$XamarinUITest$" />
    <!--#endif-->
    <!--#if (mauiEmbedding)-->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!--#if (tfm == 'net10.0')-->
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <!--#endif-->
    <!--#endif-->
    <!--#if (enableDeveloperMode)-->
    $$EnableDeveloperMode_CPM_PackageVersion$$
    <!--#endif-->
  </ItemGroup>
  <!--#if (useWasmPackageVersions)-->

  <ItemGroup Condition="$(UsingUnoSdk) != 'true'">
    <PackageVersion Include="Uno.Wasm.Bootstrap.Server" Version="$UnoWasmBootstrapVersion$" />
  </ItemGroup>
  <!--#endif-->
</Project>
