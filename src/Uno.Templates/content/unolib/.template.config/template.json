{
  "$schema": "http://json.schemastore.org/template",
  "author": "Uno Platform",
  "classifications": [
    "Multi-platform",
    "Uno Platform",
    "Library",
    "Android",
    "iOS",
    "Windows",
    "macOS",
    "Linux",
    "WebAssembly"
  ],
  "name": "Uno Platform Class Library",
  "identity": "Uno.Platform.UnoLib",
  "groupIdentity": "Uno.Platform.BlankLibrary",
  "description": "Template for creating a class library for the Uno Platform that targets WinUI, Android, iOS, WebAssembly and Skia",
  "precedence": "6001",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "shortName": "unolib",
  "sourceName": "CrossTargetedLibrary",
  "placeholderFilename": "template-ignore",
  "preferNameDirectory": true,
  "symbols": {
    "tfm": {
      "displayName": "Target Framework",
      "type": "parameter",
      "datatype": "choice",
      "enableQuotelessLiterals": true,
      "replaces": "$baseTargetFramework$",
      "defaultValue": "net10.0",
      "description": "Select the .NET version of your solution",
      "choices": [
        {
          "choice": "net10.0",
          "displayName": ".NET 10.0",
          "description": "Target .NET 10.0 (Long Term Support)"
        },
        {
          "choice": "net11.0",
          "displayName": ".NET 11.0",
          "description": "Target .NET 11.0 (Standard Term Support)"
        }
      ]
    },
    "unoSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "DefaultUnoSdkVersion",
      "replaces": "$UnoSdkVersion$"
    },
    "globalJson": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "renderer": {
    "type": "parameter",
    "datatype": "choice",
    "allowMultipleValues": false,
    "enableQuotelessLiterals": true,
    "defaultValue": "skia",
    "choices": [
      { "choice": "skia",   "displayName": "Skia" },
      { "choice": "native", "displayName": "Native" }
    ]
  },
  "useSkiaRenderer": {
    "type": "computed",
    "datatype": "bool",
    "value": "(renderer == 'skia')"
  }
  },
  "primaryOutputs": [
    {
      "path": "CrossTargetedLibrary.csproj"
    }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!globalJson)",
          "exclude": [
            "global.json"
          ]
        }
      ]
    }
  ]
}
