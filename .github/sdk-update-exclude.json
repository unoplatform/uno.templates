{
  "exclude": [
    // SkiaSharp stays excluded, but for a different reason than on the 6.x branches: Uno Platform 7.0
    // requires SkiaSharp 4.151.1 (Uno.WinUI 7.0.0-dev.645 nuspec), and the updater cannot make that move
    // itself -- "SkiaSharp" is in majorUpgradeDisabledGroups (tools/Uno.Sdk.Updater/Program.cs:364), so it
    // would only ever drag the group along the 3.x line. Left to itself it selects 3.119.4, the very build
    // the 6.x hold exists to avoid (iOS-26.2 assets break iOS <26.2; unoplatform/uno#23680,
    // unoplatform/uno.chefs#1750). The v4 version below is therefore set deliberately and by hand.
    "SkiaSharp",
    "WinAppSdk"
  ]
}
